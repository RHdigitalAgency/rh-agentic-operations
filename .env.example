# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_CURRENCY=USD

# Database
# Leave DATABASE_URL blank for local development: the app uses an embedded
# Postgres (PGlite) stored in ./.data/pglite. Set it to any Postgres URL
# (e.g. the Supabase pooled connection string) for shared/staging/production.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# Supabase (reserved for the Supabase Auth adapter - see adrs/0003). Not required for v0.1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External lead ingestion (POST /api/integrations/leads).
# Endpoint is disabled (503) until this is set. Generate a long random value per environment.
INSTAGRAM_INGESTION_SHARED_SECRET=

# Stripe (optional, US card payments for audits). Leave blank to keep manual payment confirmation only.
# Webhook endpoint: /api/integrations/stripe (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App security
APP_ENCRYPTION_KEY=

# Local demo seed only (refused when NODE_ENV=production). Password for all demo users.
SEED_DEMO_PASSWORD=rh-local-demo

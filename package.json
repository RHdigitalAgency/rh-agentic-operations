  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
